{
  "buildCommand": "npm run build",
  "routes": [
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/audio/(.*)", "headers": { "Cache-Control": "public, max-age=31536000" } },
    { "src": "/sw.js", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "src": "/manifest.webmanifest" },
    { "src": "/robots.txt" },
    { "src": "/(.*)", "dest": "/.output/server/index.mjs" }
  ]
}
